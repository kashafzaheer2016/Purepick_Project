# ── Django Core ───────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# ── Environment ───────────────────────────────────────────────────────────────
# Use: purepick_core.settings.dev  OR  purepick_core.settings.prod
DJANGO_SETTINGS_MODULE=purepick_core.settings.dev

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=purepick_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google OAuth (server-side token verification) ─────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Android Client ID (type 1, for reference only - NOT used here):
# 475901765248-8ab3mv23ke96kv4r7pq7uglu2c6u7vsb.apps.googleusercontent.com
# 
# ⚠ Set this to your WEB Client ID (type 3) once created in Google Cloud Console:
GOOGLE_CLIENT_ID=475901765248-ceko722evo5ar2ug44rdup7m3n8or8ko.apps.googleusercontent.com

# ── Production only ───────────────────────────────────────────────────────────
# ALLOWED_HOSTS_CSV=yourdomain.com,www.yourdomain.com
# CORS_ALLOWED_ORIGINS_CSV=https://yourdomain.com

# ── Redis (Celery broker + result backend) ────────────────────────────────────
# Local dev: redis://localhost:6379/0
# Docker:    redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Email (password reset) ────────────────────────────────────────────────────
# Dev: leave EMAIL_BACKEND blank (defaults to console backend)
# Prod: use SendGrid or SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
# DEFAULT_FROM_EMAIL=noreply@purepick.app
FRONTEND_BASE_URL=purepick://

# ── Firebase Admin (FCM push notifications) ──────────────────────────────────
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
